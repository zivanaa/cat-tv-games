#!/bin/sh
# Enforces branch naming, and keeps main from being pushed to directly.
# Bypass either check with: git push --no-verify

branch="$(git rev-parse --abbrev-ref HEAD)"
types='feat|fix|chore|docs|refactor|test|perf|ci|build|style'

if [ "$branch" = "main" ]; then
  cat >&2 <<MSG

  Refusing to push directly to main.

  Work on a branch and open a PR:
    git switch -c feat/what-you-are-doing

  Bootstrapping the repo, or genuinely need this?
    git push --no-verify

MSG
  exit 1
fi

if ! printf '%s' "$branch" | grep -qE "^($types)/([0-9]+-)?[a-z0-9]+(-[a-z0-9]+)*$"; then
  cat >&2 <<MSG

  Branch name rejected: $branch

  Format:  <type>/<kebab-case-description>
           <type>/<issue-number>-<kebab-case-description>
  Types:   $types

  Good:    feat/paw-input-assist
           fix/generous-tier-reach
           feat/42-rolling-buffer-android
  Bad:     my-branch          (no type)
           feat/PawInput      (not kebab-case)
           feature/thing      (use feat, not feature)

  Rename it:
    git branch -m feat/your-description

MSG
  exit 1
fi

exit 0
